{
  "schemaVersion": 2,
  "kind": "author-written-synthetic-retrieval",
  "experiences": [
    {
      "id": "atomic-file",
      "split": "development",
      "family": "atomic-file",
      "title": "Atomic file replacement",
      "strategy": "Write a temporary sibling, flush its contents, then rename over the destination only after a complete write."
    },
    {
      "id": "empty-value",
      "split": "development",
      "family": "empty-value",
      "title": "Preserve explicit zero defaults",
      "strategy": "Use an explicit None check instead of truthiness when assigning fallback settings; zero and empty strings are valid values."
    },
    {
      "id": "tenant-cache",
      "split": "development",
      "family": "tenant-cache",
      "title": "Tenant cache isolation",
      "strategy": "Include tenant identity and request parameters in every cache key; never reuse a cached result across accounts."
    },
    {
      "id": "validate-state",
      "split": "development",
      "family": "validate-state",
      "title": "Validate before mutation",
      "strategy": "Check known invalid input and raise before changing shared state; rejected operations must leave the original balance unchanged."
    },
    {
      "id": "resource-release",
      "split": "holdout",
      "family": "resource-release",
      "title": "Release acquired resources",
      "strategy": "Close open file handles in a finally block or context manager even when parsing raises; preserve the original exception."
    },
    {
      "id": "retry-deduplication",
      "split": "holdout",
      "family": "retry-deduplication",
      "title": "Deduplicate retried commands",
      "strategy": "Persist a stable idempotency key with the completed result; return the recorded response for a repeated request without charging again."
    },
    {
      "id": "cursor-order",
      "split": "holdout",
      "family": "cursor-order",
      "title": "Stable cursor pagination",
      "strategy": "Sort records by a unique pair of timestamp and identifier; encode both in the next cursor to avoid skipping equal timestamps."
    },
    {
      "id": "schema-upgrade",
      "split": "holdout",
      "family": "schema-upgrade",
      "title": "Transactional schema upgrades",
      "strategy": "Run data conversion and schema version updates in one transaction; roll back both if a conversion fails and preserve existing rows."
    },
    {
      "id": "process-cancel",
      "split": "holdout",
      "family": "process-cancel",
      "title": "Cancel timed-out process trees",
      "strategy": "On deadline expiration terminate spawned descendants as well as the parent, drain bounded output and wait for cleanup before returning."
    },
    {
      "id": "money-decimal",
      "split": "holdout",
      "family": "money-decimal",
      "title": "Exact monetary arithmetic",
      "strategy": "Parse currency values from strings into Decimal, apply an explicit rounding rule and avoid binary floating point for totals."
    }
  ],
